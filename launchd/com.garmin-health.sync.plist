<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: install.sh fills in __PROJECT__ and __LOGS__. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.garmin-health.sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PROJECT__/bin/garmin-health</string>
        <string>sync</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__PROJECT__</string>
    <!-- 06:30 and 21:00 local time. If the Mac is asleep then, launchd runs it on wake. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key><integer>6</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>21</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>
    <!-- Python logs go to __LOGS__/sync.log; this only catches crashes. -->
    <key>StandardOutPath</key>
    <string>__LOGS__/launchd-sync.log</string>
    <key>StandardErrorPath</key>
    <string>__LOGS__/launchd-sync.log</string>
</dict>
</plist>
